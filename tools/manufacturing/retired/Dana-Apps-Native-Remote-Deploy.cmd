@echo off
setlocal EnableExtensions
cd /d "%~dp0"
title Dana Apps V70.0.2R9-D3 - Native Remote Host Deploy
set "PAYLOAD_B64=%TEMP%\DanaApps-V70.0.2R9-D3-%RANDOM%%RANDOM%.b64"
set "PAYLOAD_JS=%TEMP%\DanaApps-V70.0.2R9-D3-%RANDOM%%RANDOM%.js"
echo >"%PAYLOAD_B64%"
echo >>"%PAYLOAD_B64%"
echo >>"%PAYLOAD_B64%"
echo >>"%PAYLOAD_B64%"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$b=[Convert]::FromBase64String((Get-Content -Raw -LiteralPath '%PAYLOAD_B64%').Replace([Environment]::NewLine,'').Replace(' ',''));[IO.File]::WriteAllBytes('%PAYLOAD_JS%',$b)"
if errorlevel 1 goto :preflight_fail
for /f "tokens=*" %%H in ('powershell.exe -NoLogo -NoProfile -Command "(Get-FileHash -Algorithm SHA256 -LiteralPath '%PAYLOAD_JS%').Hash"') do set "ACTUAL_SHA=%%H"
if /I not "%ACTUAL_SHA%"=="DCA610549664CED34CC3AA73F9B247AF8D5F392A33B0C8F3FF01BEE150AF44EF" goto :sha_fail
node --check "%PAYLOAD_JS%"
if errorlevel 1 goto :syntax_fail
echo [PASS] Exact extracted D3 payload SHA and syntax validation passed.
echo.
node "%PAYLOAD_JS%"
set "RC=%ERRORLEVEL%"
del /q "%PAYLOAD_B64%" "%PAYLOAD_JS%" >nul 2>&1
if not "%RC%"=="0" goto :deploy_fail
goto :success

:sha_fail
echo [FAIL] Embedded D3 payload SHA mismatch.
goto :preflight_fail

:syntax_fail
echo [FAIL] Embedded D3 Node payload syntax failure.
goto :preflight_fail

:preflight_fail
del /q "%PAYLOAD_B64%" "%PAYLOAD_JS%" >nul 2>&1
echo.
echo ============================================================
echo   DANA APPS V70.0.2R9-D3 STOPPED BEFORE DEPLOYMENT
echo ============================================================
pause
exit /b 1

:deploy_fail
echo.
echo ============================================================
echo   DANA APPS V70.0.2R9-D3 DEPLOYMENT FAILED
echo   NO DATABASE/VOLUME DELETE OPERATION WAS USED
echo ============================================================
pause
exit /b %RC%

:success
echo.
echo ============================================================
echo   DANA APPS V70.0.2R9-D3 NATIVE REMOTE DEPLOY - PASS
echo ============================================================
pause
exit /b 0
