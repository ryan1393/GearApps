{
  "name": "server-feat-location-tray",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/server/feat-location-tray/src",
  "projectType": "library",
  "tags": [
    "type:feature",
    "scope:server",
    "domain:gear-apps"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
