{
  "name": "frontend-feature-admin-users",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/feature-admin-users/src",
  "prefix": "gear",
  "projectType": "library",
  "tags": [
    "type:feature",
    "scope:frontend",
    "framework:angular",
    "domain:gear-apps"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/frontend/feature-admin-users/jest.config.ts",
        "passWithNoTests": true,
        "tsConfig": "libs/frontend/feature-admin-users/tsconfig.spec.json"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/frontend/feature-admin-users/**/*.ts",
          "libs/frontend/feature-admin-users/**/*.html"
        ]
      }
    }
  }
}
