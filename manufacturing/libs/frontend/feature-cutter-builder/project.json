{
  "name": "frontend-feature-cutter-builder",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "manufacturing/libs/frontend/feature-cutter-builder/src",
  "projectType": "library",
  "tags": [
    "type:feature",
    "scope:frontend",
    "domain:gear-apps"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "manufacturing/libs/frontend/feature-cutter-builder"
      },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/manufacturing/libs/frontend/feature-cutter-builder"
      ],
      "options": {
        "command": "jest --config manufacturing/libs/frontend/feature-cutter-builder/jest.config.cts --runInBand --passWithNoTests",
        "cwd": ".",
        "env": {
          "NODE_ENV": "test",
          "ENVIRONMENT": "test",
          "NX_DAEMON": "false",
          "JWT_ACCESS_SECRET": "unit-test-access-secret-no-production-use",
          "JWT_REFRESH_SECRET": "unit-test-refresh-secret-no-production-use",
          "DATABASE_TYPE": "better-sqlite3",
          "DATABASE_PATH": ":memory:",
          "EMAIL_ENABLED": "false",
          "SOCIAL_GOOGLE_ENABLED": "false",
          "SENTRY_DSN": ""
        }
      },
      "configurations": {
        "ci": {
          "command": "jest --config manufacturing/libs/frontend/feature-cutter-builder/jest.config.cts --runInBand --passWithNoTests --ci --coverage"
        }
      }
    }
  }
}
