{
  "name": "frontend-data-access-user",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/data-access-user/src",
  "projectType": "library",
  "tags": [
    "type:data-access",
    "scope:frontend",
    "domain:gear-apps"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/frontend/data-access-user/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/frontend/data-access-user/jest.config.ts",
        "passWithNoTests": true,
        "tsConfig": "libs/frontend/data-access-user/tsconfig.spec.json"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
