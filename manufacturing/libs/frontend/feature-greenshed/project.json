{
  "name": "frontend-feature-greenshed",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/feature-greenshed/src",
  "projectType": "library",
  "tags": [
    "type:feature",
    "scope:frontend",
    "domain:gear-apps"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/frontend/feature-greenshed/**/*.ts",
          "libs/frontend/feature-greenshed/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/frontend/feature-greenshed/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
