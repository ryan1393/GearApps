{
  "name": "frontend-feature-blade-tracking",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/feature-blade-tracking/src",
  "prefix": "gear",
  "projectType": "library",
  "tags": [
    "type:feature",
    "scope:frontend",
    "framework:angular",
    "domain:gear-apps"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/frontend/feature-blade-tracking/jest.config.ts",
        "passWithNoTests": true,
        "tsConfig": "libs/frontend/feature-blade-tracking/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/frontend/feature-blade-tracking/**/*.ts",
          "libs/frontend/feature-blade-tracking/**/*.html"
        ]
      }
    }
  }
}
