{
  "name": "gear-app-server-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "gear-app-server"
  ],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/manufacturing/apps/server-e2e"
      ],
      "options": {
        "command": "jest --config manufacturing/apps/server-e2e/jest.config.cts --runInBand --passWithNoTests",
        "cwd": ".",
        "env": {
          "NODE_ENV": "test",
          "ENVIRONMENT": "test",
          "NX_DAEMON": "false",
          "JWT_ACCESS_SECRET": "unit-test-access-secret-no-production-use",
          "JWT_REFRESH_SECRET": "unit-test-refresh-secret-no-production-use",
          "DATABASE_TYPE": "better-sqlite3",
          "DATABASE_PATH": ":memory:",
          "EMAIL_ENABLED": "false",
          "SOCIAL_GOOGLE_ENABLED": "false",
          "SENTRY_DSN": ""
        }
      },
      "configurations": {
        "ci": {
          "command": "jest --config manufacturing/apps/server-e2e/jest.config.cts --runInBand --passWithNoTests --ci --coverage"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "manufacturing/apps/server-e2e"
      },
      "cache": true
    }
  },
  "tags": [
    "domain:gear-apps"
  ]
}
