{
  "name": "blade-tracking-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "manufacturing/apps/blade-tracking-e2e/src",
  "projectType": "application",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cypress run --config-file manufacturing/apps/blade-tracking-e2e/cypress.config.ts",
        "cwd": "."
      },
      "dependsOn": [
        "blade-tracking:serve-static"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "manufacturing/apps/blade-tracking-e2e"
      },
      "cache": true
    }
  },
  "tags": [
    "domain:gear-apps"
  ],
  "implicitDependencies": [
    "blade-tracking"
  ]
}
