{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@gearapps/shared/domain": ["./libs/shared/domain/src/index.ts"],
      "@gearapps/api/core": ["./libs/api/core/src/index.ts"],
      "@gearapps/api/data-access": ["./libs/api/data-access/src/index.ts"],
      "@gearapps/api/feature-auth": ["./libs/api/feature-auth/src/index.ts"],
      "@gearapps/api/feature-gear": ["./libs/api/feature-gear/src/index.ts"],
      "@gearapps/api/feature-cutter-tracking": ["./libs/api/feature-cutter-tracking/src/index.ts"],
      "@gearapps/api/feature-scanner": ["./libs/api/feature-scanner/src/index.ts"],
      "@gearapps/client/core": ["./libs/client/core/src/index.ts"],
      "@gearapps/client/ui": ["./libs/client/ui/src/index.ts"],
      "@gearapps/client/shell": ["./libs/client/shell/src/index.ts"],
      "@gearapps/client/feature-auth": ["./libs/client/feature-auth/src/index.ts"],
      "@gearapps/client/feature-dashboard": ["./libs/client/feature-dashboard/src/index.ts"],
      "@gearapps/client/feature-machines": ["./libs/client/feature-machines/src/index.ts"],
      "@gearapps/client/feature-parts": ["./libs/client/feature-parts/src/index.ts"],
      "@gearapps/client/feature-lapping-summary": [
        "./libs/client/feature-lapping-summary/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
