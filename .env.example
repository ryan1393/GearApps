# ---- Server ----
HOST=0.0.0.0
PORT=3334
ENVIRONMENT=development
# Comma-separated origins allowed to call the API cross-origin (dev server, kiosks).
# Leave empty when the API is served behind the client's reverse proxy.
CORS_ORIGINS=http://localhost:4203
SWAGGER_ENABLED=true

# ---- Database ----
# Same PostgreSQL database used by GearApps 70.3.0.
DATABASE_TYPE=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=server
DATABASE_PASSWORD=replace-this-db-password
DATABASE_NAME=GearApps
DATABASE_SSL=false
# Required for shared PostgreSQL. Lapper applies additive migrations in schema lapper.
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING_ENABLED=false
# Time zone of historical SQL Server timestamps (new collector timestamps include UTC offset).
LAPPER_TIME_ZONE=America/Indianapolis
# Legacy standalone backends remain available explicitly:
# DATABASE_TYPE=better-sqlite3
# DATABASE_PATH=tmp/gearapps.sqlite
# DATABASE_TYPE=mssql
# DATABASE_INSTANCE=SQLEXPRESS

# ---- Auth ----
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRES_IN=10h

# ---- Scanners (lapping-cell live view) ----
# Used only by the legacy un-keyed /scanner routes; keyed routes use the scanner's DB record.
SCANNER_DEFAULT_HOST=10.16.80.68
SCANNER_ALLOW_INSECURE_TLS=true
SCANNER_TIMEOUT_MS=4000
# FTP drop where scanners publish <root>/<scanner-ip>/<image-file>
SCANNER_FTP_HOST=usftwplvfs02
SCANNER_FTP_USER=
SCANNER_FTP_PASSWORD=
SCANNER_FTP_ROOT=181-lapper-scanners
SCANNER_FTP_IMAGE_FILE=scanner-current.jpg
