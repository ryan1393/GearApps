# MeshForge settings. Copy this file to .env and fill in section 1.
#
#   1. Required before the first start   secrets and the database login
#   2. API settings                      can be changed later in Admin > Server Settings
#   3. Docker host settings              read by Docker Compose only; change them here
#
# A value saved in Admin > Server Settings is kept in the database and replaces the value
# in this file the next time the API starts. The database connection, the JWT secrets, the
# listen address and file paths are locked there and can only be changed in this file.

# ============================================================================
# 1. Required before the first start
# ============================================================================

# JWT secrets sign every login. Use different 32+ random characters for each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The deploy script refuses placeholder or short values.
JWT_ACCESS_SECRET=replace-this-access-secret
JWT_REFRESH_SECRET=replace-this-refresh-secret

# Database the API connects to when it is started outside Docker.
# Under Docker the API uses GEAR_DB_* from section 3 instead.
DATABASE_TYPE=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=server
DATABASE_PASSWORD=replace-this-db-password
DATABASE_NAME=MeshForge
# true logs every SQL query. Verbose; use only while investigating a problem.
DATABASE_LOGGING_ENABLED=false
DATABASE_SYNCHRONIZE=false

# First accounts, created once when an empty database is set up (12+ characters each).
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
SEED_USER_PASSWORD=replace-with-strong-user-password

# ============================================================================
# 2. API settings (Admin > Server Settings can change these afterwards)
# ============================================================================

#----- Server
NODE_ENV=development
ENVIRONMENT=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3333
API_PREFIX=api
API_VERSION=v1
# Other web origins allowed to call the API from a browser, comma separated, such as
# http://server:4200,http://server:4201. Empty (or *) allows none: the MeshForge web clients
# call the API on their own origin and need no entry here.
CORS_ORIGINS=
# Proxies whose X-Forwarded-For is trusted for the client address (sign-in rate limits, badge
# login). Express "trust proxy" syntax: loopback, uniquelocal, linklocal, IPs or CIDR ranges,
# comma separated; a hop count such as 1; true to trust any; false for none.
# The default trusts the nginx web clients on the same host or private network.
TRUST_PROXY=loopback, uniquelocal
# Serves the Swagger page at /api/v1. With NODE_ENV=production it is off unless this is true.
ENABLE_SWAGGER=true
GENERATE_SWAGGER_JSON=true
SWAGGER_JSON_FILE=swagger.json
JWT_ACCESS_EXPIRATION_TIME=3600s
JWT_REFRESH_EXPIRATION_TIME=86400s
# Addresses used in emailed links.
PUBLIC_API_BASE_URL=http://localhost:3333
PUBLIC_WEB_BASE_URL=http://localhost:4200
SENTRY_DSN=

#----- Google sign-in (optional)
SOCIAL_GOOGLE_ENABLED=false
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=

#----- Email (password recovery and Coater RPA)
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_SECURE=true
EMAIL_REQUIRE_TLS=true
EMAIL_IGNORE_TLS=false
EMAIL_DEBUG=false
EMAIL_DEFAULT_NAME=
EMAIL_DEFAULT_EMAIL=
EMAIL_TEMPLATE_DIR=apps/server/src/assets/templates
EMAIL_PARTIALS_DIR=apps/server/src/assets/templates/partials

#----- Label printers
# Printers are normally set up in Admin > Label Printers (name, address, IPL or ZPL, default).
# These values are only the fallback tag printer, used until a default tag printer is chosen
# there. When host is blank and no printer is set up, Print Tag downloads the tag file.
GEAR_LABEL_PRINTER_HOST=
GEAR_LABEL_PRINTER_PORT=9100
# IPL (Intermec / Honeywell) or ZPL (Zebra).
GEAR_LABEL_PRINTER_LANGUAGE=IPL
GEAR_LABEL_PRINTER_TIMEOUT_MS=5000

#----- Greenshed
# Pieces a running machine cuts between required quality checks.
GREENSHED_CHECK_INTERVAL=25

#----- Lapper and scanners
LAPPER_TIME_ZONE=America/Indianapolis
SCANNER_DEFAULT_HOST=
SCANNER_ALLOW_INSECURE_TLS=true
SCANNER_TIMEOUT_MS=4000
# FTP server where scanners save their captures, by default under <root>/<scanner-ip>/.
# A scanner can use its own folder and file instead: Lapper Admin > Scanners > Image location.
SCANNER_FTP_HOST=
SCANNER_FTP_USER=
SCANNER_FTP_PASSWORD=
SCANNER_FTP_ROOT=181-lapper-scanners
# Default capture name. If missing, the dashboard uses the newest saved JPEG or BMP in that folder.
SCANNER_FTP_IMAGE_FILE=scanner-current.jpg

#----- DSF (Digital Shop Floor / Ignition) production counts
# Optional and off by default. The API pulls from the DSF PostgreSQL source read-only; nothing
# is ever written to DSF. See docs/manufacturing/DSF_COUNTS.md before enabling.
#   DSF_COUNT_ENABLED=true        reads DSF and shows DSF counts for mapped machines
#   DSF_CUTTER_WRITE_ENABLED=true also credits that production to the cutter on each machine
DSF_COUNT_ENABLED=false
DSF_HISTORY_ENABLED=false
# Initial/repeated backfill horizon. Saved hourly/shift count records are not automatically deleted.
DSF_HISTORY_LOOKBACK_DAYS=7
DSF_CUTTER_WRITE_ENABLED=false
DSF_COUNT_INTERVAL_SECONDS=60
# Machine numbers whose reference mapping may be used, comma separated (for example 516,517).
# Machines mapped by an administrator in Admin > DSF Mappings do not need to be listed.
DSF_COUNT_MACHINES=
# DSF departments that are not named like "Dept. 132", as NAME=MeshForge department number,
# comma separated. Empty means CUTTER GRIND=45 (the CutGrind grinders in Department 45).
DSF_DEPARTMENT_NAMES=
DSF_DB_HOST=
# The working client port and SSL mode must be confirmed for your network; 5432 is only the default.
DSF_DB_PORT=5432
DSF_DB_NAME=
DSF_DB_USER=
# Supply the password here OR in a file (not both). Never commit a real password.
DSF_DB_PASSWORD=
DSF_DB_PASSWORD_FILE=
# verify-full (default, optional CA below) or disable.
DSF_DB_SSL_MODE=verify-full
DSF_DB_SSL_CA_FILE=
DSF_DB_SSL_CA_PEM=
# Leave empty unless the DSF login is not a restricted read-only role; see DSF_COUNTS.md.
DSF_PRIVILEGED_READER_ACK=

# ============================================================================
# 3. Docker host settings (Docker Compose reads these; not shown in Admin)
# ============================================================================

#----- PostgreSQL container and the login the Docker API uses
GEAR_DB_USERNAME=server
GEAR_DB_PASSWORD=replace-this-db-password
GEAR_DB_NAME=MeshForge
# Port the database is published on, on the Docker host.
DANA_POSTGRES_PORT=5432
# Persistent Docker database volume (preserve this on upgrades).
DANA_POSTGRES_VOLUME_NAME=dana-apps-gear-postgres

#----- Published ports and public addresses
GEAR_API_PORT=3333
GEAR_BLADE_UI_PORT=4200
GEAR_CUTTER_UI_PORT=4201
GEAR_GREENSHED_UI_PORT=4202
LAPPER_UI_PORT=4203
GEAR_PUBLIC_API_BASE_URL=http://localhost:3333
GEAR_PUBLIC_WEB_BASE_URL=http://localhost:4200

#----- Lapper Read collector (started with --profile collectors)
# Where the API asks the collector for live macro values (Cycle Test Lab > Read values from machine).
# Empty uses the Docker address http://lapper-read:8080.
LAPPER_READ_STATUS_URL=
# One container collects from every Active machine that has a FANUC controller IP in
# Lapper (with an assigned scanner its cycles get the scanned serial). FANUC's licensed
# Linux libfwlib32.so goes in apps/lapper-read-py/fanuc/ (or set LAPPER_READ_FOCAS_DIR).
# How the collector signs in. Normally nothing to set here: an admin clicks
# Connect Docker collector in Admin > Collector Tokens and the API
# hands the collector its token on a private volume. To override, paste a collector
# token (starts with glr_) here instead.
LAPPER_READ_API_TOKEN=
# Legacy: an administrator account's sign-in, ignored when a token is set. Regular
# accounts can no longer send machine data (HTTP 403); use a collector token.
LAPPER_READ_API_EMAIL=
LAPPER_READ_API_PASSWORD=
# Shared by the Docker collector and the dashboard's Tune and Focus commands.
LAPPER_READ_SCANNER_PORT=9004
LAPPER_READ_POLL_INTERVAL_MS=250
# How often saved machines are re-read, in seconds.
LAPPER_READ_DISCOVER_INTERVAL_S=30
# Host port for http://<docker-host>:8090/status (worker status per machine).
LAPPER_READ_STATUS_PORT=8090
LAPPER_READ_FOCAS_DIR=./apps/lapper-read-py/fanuc
# Argonaut (Track and Trace): also send each finished cycle's FANUC macros to Argonaut, as the
# original C# Lapper Read did. Off until set to true; cycles without a scanned serial are not sent.
# These are the starting values: Admin > Server Settings > Lapping and scanners can change the address, location,
# sign-in, transaction type and certificate check, and the collector picks them up from the API.
# ..._ENABLED and ..._CA_FILE stay here.
LAPPER_READ_ARGONAUT_ENABLED=false
LAPPER_READ_ARGONAUT_URL=
LAPPER_READ_ARGONAUT_LOCATION_ID=
# Basic sign-in Argonaut expects. Leave both empty to sign in as the original C# Lapper Read did
# (user / pw, i.e. Authorization: Basic dXNlcjpwdw==).
LAPPER_READ_ARGONAUT_USERNAME=
LAPPER_READ_ARGONAUT_PASSWORD=
LAPPER_READ_ARGONAUT_TRANSACTION_TYPE_ID=100
# Set false only if Argonaut uses a self-signed certificate (the original collector skipped the
# check); better, put its certificate in a file the container can read and set ..._CA_FILE.
LAPPER_READ_ARGONAUT_VERIFY_TLS=true
LAPPER_READ_ARGONAUT_CA_FILE=

# ============================================================================
# Test machines only
# ============================================================================
# The tools/test-data fixture scripts create accounts with passwords published in this repo,
# including an admin. They refuse to run unless this is YES. Never set it on production.
# MESHFORGE_ALLOW_TEST_ACCOUNTS=YES
