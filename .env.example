NODE_ENV=development
ENVIRONMENT=development

#== Server Settings
API_VERSION=v1
API_PREFIX=api
CORS_ORIGINS=*
ENABLE_SWAGGER=true
GENERATE_SWAGGER_JSON=true
JWT_ACCESS_EXPIRATION_TIME=3600s
JWT_REFRESH_EXPIRATION_TIME=86400s
# JWT secrets sign every login. Use different 32+ random characters for access and refresh tokens:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The deploy script refuses placeholder or short values.
JWT_ACCESS_SECRET=replace-this-access-secret
JWT_REFRESH_SECRET=replace-this-refresh-secret
SERVER_HOST=127.0.0.1
SERVER_PORT=3333
SWAGGER_JSON_FILE=swagger.json

DATABASE_TYPE=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=server
DATABASE_PASSWORD=replace-this-db-password
DATABASE_NAME=GearApps
DATABASE_LOGGING_ENABLED=true
DATABASE_SYNCHRONIZE=false

#===== Sentry Config
SENTRY_DSN=

#===== Google Login Integration
SOCIAL_GOOGLE_ENABLED=false
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=

#===== Server SMTP Settings
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_TEMPLATE_DIR=apps/server/src/assets/templates
EMAIL_PARTIALS_DIR=apps/server/src/assets/templates/partials
EMAIL_IGNORE_TLS=false
EMAIL_REQUIRE_TLS=true
EMAIL_DEBUG=false
EMAIL_DEFAULT_NAME=
EMAIL_DEFAULT_EMAIL=
EMAIL_SECURE=true

# Optional database seed credentials. If omitted, random passwords are generated.
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
SEED_USER_PASSWORD=replace-with-strong-user-password
PUBLIC_API_BASE_URL=http://localhost:3333
PUBLIC_WEB_BASE_URL=http://localhost:4200

#===== Dana Apps host / Docker namespace
DANA_POSTGRES_PORT=5432
DANA_POSTGRES_USERNAME=server
DANA_POSTGRES_PASSWORD=replace-this-db-password
GEAR_API_PORT=3333
GEAR_BLADE_UI_PORT=4200
GEAR_CUTTER_UI_PORT=4201
GEAR_GREENSHED_UI_PORT=4202
LAPPER_UI_PORT=4203
LAPPER_TIME_ZONE=America/Indianapolis
GEAR_DB_USERNAME=server
GEAR_DB_PASSWORD=replace-this-db-password
GEAR_DB_NAME=GearApps
GEAR_PUBLIC_API_BASE_URL=http://localhost:3333
GEAR_PUBLIC_WEB_BASE_URL=http://localhost:4200

#===== Dana Apps host / Docker namespace
DANA_POSTGRES_VOLUME_NAME=dana-apps-gear-postgres

#===== Label printers
# Printers are normally set up in Admin > Label Printers (name, address, IPL or ZPL, default).
# These values are only the fallback tag printer, used until a default tag printer is chosen
# there. When host is blank and no printer is set up, Print Tag downloads the tag file.
GEAR_LABEL_PRINTER_HOST=
GEAR_LABEL_PRINTER_PORT=9100
# IPL (Intermec / Honeywell) or ZPL (Zebra).
GEAR_LABEL_PRINTER_LANGUAGE=IPL
GEAR_LABEL_PRINTER_TIMEOUT_MS=5000

#===== Test fixtures (TEST machines only)
# The tools/test-data fixture scripts create accounts with passwords published in this repo,
# including an admin. They refuse to run unless this is YES. Never set it on production.
# GEAR_APPS_ALLOW_TEST_ACCOUNTS=YES

# Lapper scanners, used by the shared GearApps API
SCANNER_DEFAULT_HOST=
SCANNER_ALLOW_INSECURE_TLS=true
SCANNER_TIMEOUT_MS=4000
SCANNER_FTP_HOST=
SCANNER_FTP_USER=
SCANNER_FTP_PASSWORD=
SCANNER_FTP_ROOT=181-lapper-scanners
SCANNER_FTP_IMAGE_FILE=scanner-current.jpg

#===== DSF (Digital Shop Floor / Ignition) production counts for cutting Departments 132 and 152
# Optional and off by default. The API pulls from the DSF PostgreSQL source read-only; nothing
# is ever written to DSF. See docs/manufacturing/DSF_COUNTS.md before enabling.
#   DSF_COUNT_ENABLED=true        reads DSF and shows a DSF Count column on Running Machines
#   DSF_CUTTER_WRITE_ENABLED=true also credits that production to the cutter on each machine
DSF_COUNT_ENABLED=false
DSF_CUTTER_WRITE_ENABLED=false
DSF_COUNT_INTERVAL_SECONDS=60
# Machine numbers whose reference mapping may be used, comma separated (for example 516,517).
# Machines mapped by an administrator in Admin > DSF Mappings do not need to be listed.
DSF_COUNT_MACHINES=
DSF_DB_HOST=
# The working client port and SSL mode must be confirmed for your network; 5432 is only the default.
DSF_DB_PORT=5432
DSF_DB_NAME=
DSF_DB_USER=
# Supply the password here OR in a file (not both). Never commit a real password.
DSF_DB_PASSWORD=
DSF_DB_PASSWORD_FILE=
# verify-full (default, optional CA below) or disable.
DSF_DB_SSL_MODE=verify-full
DSF_DB_SSL_CA_FILE=
DSF_DB_SSL_CA_PEM=
# Leave empty unless the DSF login is not a restricted read-only role; see DSF_COUNTS.md.
DSF_PRIVILEGED_READER_ACK=
