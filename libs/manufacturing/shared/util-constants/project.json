{
  "name": "shared-util-constants",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/manufacturing/shared/util-constants/src",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "libs/manufacturing/shared/util-constants"
      },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/libs/manufacturing/shared/util-constants"
      ],
      "options": {
        "command": "jest --config libs/manufacturing/shared/util-constants/jest.config.cts --runInBand --passWithNoTests",
        "cwd": ".",
        "env": {
          "NODE_ENV": "test",
          "NX_DAEMON": "false"
        }
      },
      "configurations": {
        "ci": {
          "command": "jest --config libs/manufacturing/shared/util-constants/jest.config.cts --runInBand --passWithNoTests --ci --coverage"
        }
      }
    }
  },
  "tags": [
    "type:util",
    "scope:shared",
    "domain:meshforge"
  ]
}
