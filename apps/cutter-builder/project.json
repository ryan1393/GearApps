{
  "name": "cutter-builder",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "gear",
  "sourceRoot": "apps/cutter-builder/src",
  "tags": [
    "type:app",
    "scope:frontend",
    "framework:angular",
    "domain:meshforge"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{workspaceRoot}/dist/apps/cutter-builder"
      ],
      "options": {
        "outputPath": "dist/apps/cutter-builder",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/cutter-builder/tsconfig.app.json",
        "assets": [
          "apps/cutter-builder/src/favicon.ico",
          "apps/cutter-builder/src/assets",
          {
            "glob": "**/*",
            "input": "libs/manufacturing/assets",
            "output": "assets"
          }
        ],
        "styles": [
          "apps/cutter-builder/src/styles.css",
          "libs/shared/dana-ui/src/styles/gear-compat.css",
          "libs/shared/dana-ui/src/styles/gear-compat-features.css",
          "libs/shared/dana-ui/src/styles/dana-ui.css",
          "libs/shared/dana-ui/src/styles/gear-compat-overrides.css"
        ],
        "browser": "apps/cutter-builder/src/main.ts",
        "index": "apps/cutter-builder/src/index.html"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "750kb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "proxyConfig": "apps/cutter-builder/proxy.conf.json",
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "cutter-builder:build:production"
        },
        "development": {
          "buildTarget": "cutter-builder:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "cutter-builder:build"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "apps/cutter-builder"
      },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/apps/cutter-builder"
      ],
      "options": {
        "command": "jest --config apps/cutter-builder/jest.config.cts --runInBand --passWithNoTests",
        "cwd": ".",
        "env": {
          "NODE_ENV": "test",
          "ENVIRONMENT": "test",
          "NX_DAEMON": "false",
          "JWT_ACCESS_SECRET": "unit-test-access-secret-no-production-use",
          "JWT_REFRESH_SECRET": "unit-test-refresh-secret-no-production-use",
          "DATABASE_TYPE": "better-sqlite3",
          "DATABASE_PATH": ":memory:",
          "EMAIL_ENABLED": "false",
          "SOCIAL_GOOGLE_ENABLED": "false",
          "SENTRY_DSN": ""
        }
      },
      "configurations": {
        "ci": {
          "command": "jest --config apps/cutter-builder/jest.config.cts --runInBand --passWithNoTests --ci --coverage"
        }
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "cutter-builder:build",
        "port": 4201,
        "staticFilePath": "dist/apps/cutter-builder/browser",
        "spa": true
      },
      "continuous": true,
      "readyWhen": {
        "signal": true
      }
    }
  }
}
