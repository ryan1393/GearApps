{
  "name": "truck-log-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/truck-log-server/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/truck-log-server"],
      "options": {
        "command": "webpack-cli build --config webpack.config.js",
        "cwd": "apps/truck-log-server",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "truck-log-server:build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/truck-log-server/tsconfig.app.json --noEmit"
      }
    }
  },
  "tags": ["scope:truck-log", "platform:server", "type:app"]
}
