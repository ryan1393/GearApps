{
  "name": "meshforge-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/server/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:server",
    "domain:meshforge"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/server"
      ],
      "defaultConfiguration": "production",
      "options": {
        "command": "webpack-cli build --config webpack.config.js --mode production",
        "cwd": "apps/server",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "configurations": {
        "production": {},
        "development": {
          "command": "webpack-cli build --config webpack.config.js --mode development",
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "meshforge-server:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "meshforge-server:build:development"
        },
        "production": {
          "buildTarget": "meshforge-server:build:production"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "apps/server"
      },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/apps/server"
      ],
      "options": {
        "command": "jest --config apps/server/jest.config.cts --runInBand --passWithNoTests",
        "cwd": ".",
        "env": {
          "NODE_ENV": "test",
          "ENVIRONMENT": "test",
          "NX_DAEMON": "false",
          "JWT_ACCESS_SECRET": "unit-test-access-secret-no-production-use",
          "JWT_REFRESH_SECRET": "unit-test-refresh-secret-no-production-use",
          "DATABASE_TYPE": "better-sqlite3",
          "DATABASE_PATH": ":memory:",
          "EMAIL_ENABLED": "false",
          "SOCIAL_GOOGLE_ENABLED": "false",
          "SENTRY_DSN": ""
        }
      },
      "configurations": {
        "ci": {
          "command": "jest --config apps/server/jest.config.cts --runInBand --passWithNoTests --ci --coverage"
        }
      }
    },
    "build-fresh-db-bootstrap": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/server-bootstrap"
      ],
      "defaultConfiguration": "production",
      "options": {
        "command": "webpack-cli build --config webpack.bootstrap.config.js --mode production",
        "cwd": "apps/server",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "configurations": {
        "production": {},
        "development": {
          "command": "webpack-cli build --config webpack.bootstrap.config.js --mode development",
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    }
  }
}
