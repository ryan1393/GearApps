TRUCK_LOG_RELEASE=1.0.4
TRUCK_LOG_RXO_BROWSER_PORT=6080
TRUCK_LOG_DOCKER_PROJECT=truck-log
# Truck Log configuration template.
# Run SETUP-TRUCK-LOG.cmd (Windows) or ./SETUP-TRUCK-LOG.sh (Linux).
# Setup creates .env, generates secrets, and preserves them on reruns.

NODE_ENV=production
TRUCK_LOG_API_PORT=3334
TRUCK_LOG_API_BIND_ADDRESS=127.0.0.1
TRUCK_LOG_WEB_PORT=4300
TRUCK_LOG_PUBLIC_ORIGIN=http://localhost:4300
TRUCK_LOG_CORS_ORIGINS=http://localhost:4300
# Explicit HTTP mode for the base deployment. HTTP does not encrypt traffic.
# For HTTPS use docker-compose.https.yml and docs/truck-log/HTTPS.md.
TRUCK_LOG_ADMIN_TRANSPORT=internal-http
# HTTPS overlay only: generate a unique 64-character lowercase hex secret.
TRUCK_LOG_ADMIN_PROXY_KEY=
TRUCK_LOG_TLS_PORT=443
# Absolute directory ON THE DOCKER HOST containing fullchain.pem and privkey.pem.
TRUCK_LOG_TLS_CERT_DIR=
# Change both values if this dedicated Docker subnet conflicts with your network.
TRUCK_LOG_TLS_PROXY_SUBNET=172.30.43.0/24
TRUCK_LOG_TLS_PROXY_IP=172.30.43.10

# Dockerized PostgreSQL. Setup generates the password; do not commit .env.
TRUCK_LOG_DATABASE_HOST=truck-log-postgres
TRUCK_LOG_DATABASE_PORT=5432
TRUCK_LOG_DATABASE_USERNAME=api
TRUCK_LOG_DATABASE_PASSWORD=CHANGE_ME
TRUCK_LOG_DATABASE_NAME=TruckLog
TRUCK_LOG_DATABASE_SYNCHRONIZE=false
TRUCK_LOG_DATABASE_SSL=false
TRUCK_LOG_DATABASE_ADMIN_NAME=postgres

TRUCK_LOG_DOCUMENT_STORAGE_ROOT=/data/truck-log-documents
TRUCK_LOG_MAX_DOCUMENT_MB=25
TRUCK_LOG_PRINT_CLAIM_TOKEN_SECRET=
TRUCK_LOG_PRINT_AGENT_OFFLINE_SECONDS=90
TRUCK_LOG_DRIVER_PRINT_AGENT_ID=
TRUCK_LOG_DRIVER_PRINT_ROUTE=
TRUCK_LOG_DRIVER_PRINT_PRINTER=

TZ=America/Indiana/Indianapolis

# Host-side/manual RXO helpers. Docker overrides TRUCK_LOG_RXO_LATEST_DIR inside the API container.
TRUCK_LOG_RXO_DATA_HOST_PATH=./data/rxo
TRUCK_LOG_RXO_LATEST_DIR=./data/rxo/latest
TRUCK_LOG_RXO_IMPORT_AFTER_SYNC=true
TRUCK_LOG_API_BASE_URL=http://localhost:3334/api/v1

# Standard RXO scheduler. Credentials live in the named Docker credential volume.
RXO_SYNC_INTERVAL_MINUTES=30
RXO_MAX_SCAN_DURATION_MINUTES=30
RXO_NO_PROGRESS_TIMEOUT_MINUTES=15
RXO_RECOVERY_COOLDOWN_SECONDS=30
RXO_FILTER_READY_TIMEOUT_MS=60000
RXO_CAPTURE_FAILURE_SCREENSHOT=false
TRUCK_LOG_RXO_AUTH_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=

# RXO Expedite scheduler. It has dedicated credentials inside the same credential volume.
RXO_EXPEDITE_SYNC_INTERVAL_MINUTES=30
RXO_EXPEDITE_SYNC_ON_START=true
# Leave empty: an administrator signed in at TRUCK_LOG_PUBLIC_ORIGIN can change the Expedite login.
# Set only to restrict Expedite login changes to a different, dedicated origin.
TRUCK_LOG_RXO_EXPEDITE_CONTROL_ORIGIN=
TRUCK_LOG_RXO_EXPEDITE_ALLOW_HTTP=false
