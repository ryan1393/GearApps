{
  "name": "@dana/ui",
  "version": "0.3.3",
  "description": "Shared Dana UI for every GearApps frontend.",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@angular/common": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/forms": "20.3.35",
    "rxjs": "7.8.2"
  },
  "module": "fesm2022/dana-ui.mjs",
  "typings": "index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./index.d.ts",
      "default": "./fesm2022/dana-ui.mjs"
    },
    "./styles/dana-ui.css": "./styles/dana-ui.css",
    "./styles/dana-core.css": "./styles/dana-core.css",
    "./styles/gear-compat.css": "./styles/gear-compat.css",
    "./styles/gear-compat-features.css": "./styles/gear-compat-features.css",
    "./styles/gear-compat-overrides.css": "./styles/gear-compat-overrides.css",
    "./tailwind/tailwind-preset.cjs": "./tailwind/tailwind-preset.cjs",
    "./styles/*": "./styles/*",
    "./assets/*": "./assets/*"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "style": "./styles/dana-ui.css"
}
