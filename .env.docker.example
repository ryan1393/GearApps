# Copy to .env for `docker compose up`. The database settings are wired by
# docker-compose.yml (the API always talks to the `postgres` service).

# ---- Required ----
POSTGRES_PASSWORD=change-me
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# ---- Optional ----
POSTGRES_USER=gearapps
POSTGRES_DB=gearapps
POSTGRES_PORT=5432          # host port for psql/pgAdmin (bound to 127.0.0.1 only)
LAPPER_PORT=8080            # where the app is served on the host
DATABASE_SYNCHRONIZE=true   # create/update tables on start
JWT_ACCESS_TOKEN_EXPIRES_IN=10h
ENVIRONMENT=production
SWAGGER_ENABLED=true

# ---- Scanners (lapping-cell live view) ----
SCANNER_DEFAULT_HOST=10.16.80.68
SCANNER_ALLOW_INSECURE_TLS=true
SCANNER_FTP_HOST=usftwplvfs02
SCANNER_FTP_USER=
SCANNER_FTP_PASSWORD=
SCANNER_FTP_ROOT=181-lapper-scanners
SCANNER_FTP_IMAGE_FILE=scanner-current.jpg
